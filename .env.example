# ─────────────────────────────────────────────────────────────
# cPanel production template for BCT
#
# Copy this file to .env after uploading, then set:
#   - APP_URL          your public domain (e.g. https://bct.example.com)
#   - DB_DATABASE      cPanel database name  (usually user_dbname)
#   - DB_USERNAME      cPanel database user
#   - DB_PASSWORD      cPanel database password
#
# APP_KEY and JWT_SECRET below are already filled with the same
# values used locally, so nothing needs to be regenerated.
# ─────────────────────────────────────────────────────────────

APP_NAME="BCT"
APP_ENV=production
APP_KEY=base64:/9UhFE9QNeBHNzEvqEhSLqlrWiumESDooAf7ihdW7h8=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=74JFH5F8sHDMJuV83MQXvQtOObNZqdCYwHIMCJJXKhwYPEicQZg53j1mahvqamNT
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256